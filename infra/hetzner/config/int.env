# ── INT environment configuration ─────────────────────────────────────────────
# Edit this file after running setup.sh and creating the base snapshot.

SERVER_NAME=antcrew-int
SNAPSHOT_ID=              # Set this after step 3 of initial setup (hcloud image list --type snapshot)
VOLUME_NAME=int-data
VOLUME_SIZE=10            # GB — used only by setup.sh when creating the volume

SERVER_TYPE=cx22          # 2 vCPU, 4 GB RAM, 40 GB disk — ~€0.00616/hr
LOCATION=nbg1             # Nuremberg; alternatives: fsn1 (Falkenstein), hel1 (Helsinki)
SSH_KEY_NAME=int-uat-key  # Name registered in Hetzner via setup.sh

# Where the Hetzner volume is mounted on the server
MOUNT_POINT=/mnt/antcrew-data

# Where the application lives on the server (Docker Compose project root)
APP_DIR=/opt/antcrew

# SSH wait timeout in seconds (increase if cx22 boot is slow on your project)
SSH_WAIT_TIMEOUT=120
