# Copy this file to .env and fill in your values.
# Only ANTHROPIC_API_KEY is required for a local dev run with SQLite.

# --- Required ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Database (SQLite default, PostgreSQL for prod) ---
# DATABASE_URL=sqlite+aiosqlite:///platform.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/antcrew

# --- Auth ---
# PLATFORM_API_KEY=           # Static master key; if set, skips DB key check
# BYOK_ENCRYPTION_KEY=        # Fernet key for per-workspace LLM key encryption

# --- Email (verification codes, workspace invites) ---
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=hello@example.com
# SMTP_PASSWORD=
# SMTP_FROM=hello@example.com
# SMTP_TLS=true               # true=STARTTLS | ssl=SMTPS | none=plain
# BASE_URL=http://localhost:8000

# --- Optional LLM providers ---
# OPENAI_API_KEY=sk-...
# GROQ_API_KEY=gsk_...

# --- Slack HITL ---
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_APP_TOKEN=xapp-...
# SLACK_CHANNEL_ID=C...
# SLACK_TOKEN_ENCRYPTION_KEY=  # Fernet key for per-workspace Slack token encryption

# --- Telegram HITL ---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# --- GitHub PR automation ---
# GITHUB_TOKEN=ghp_...

# --- Webhooks ---
# WEBHOOK_URL=                 # Global fallback webhook on every pipeline.end
# PLATFORM_BASE_URL=http://localhost:8000  # Public URL embedded in review links

# --- Engine ---
# ANTCREW_WORKERS=4            # Background thread pool size
# HITL_TIMEOUT_S=3600          # Seconds before HITL review auto-times-out
